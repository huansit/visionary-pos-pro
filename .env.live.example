NODE_ENV=production
VISIONPOS_MODE=live
PORT=3000
PUBLIC_APP_URL=https://visionarypos.cloud
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/visionary_live
UPLOAD_PATH=/var/visionary/live/uploads
BACKUP_PATH=/var/visionary/live/backups
DEVICE_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
DEVICE_SETUP_KEY=replace-with-a-different-random-secret-at-least-32-characters
CORS_ORIGINS=https://visionarypos.cloud,https://www.visionarypos.cloud,tauri://localhost,http://tauri.localhost,https://tauri.localhost
ADMIN_EMAIL_CODE_REQUIRED=1
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-brevo-smtp-login
SMTP_PASS=replace-with-brevo-smtp-key
SMTP_FROM=VisionPOS <verified-sender@visionarypos.cloud>
SMTP_MAX_CONNECTIONS=2
SMTP_MAX_MESSAGES=100
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
ADMIN_LOGIN_CODE_RATE_WINDOW_MINUTES=10
ADMIN_LOGIN_CODE_RATE_MAX=5

# Kopo Kopo starts in sandbox. Change the mode/base URL only after production approval.
KOPOKOPO_ENABLED=0
KOPOKOPO_MODE=sandbox
KOPOKOPO_BASE_URL=https://sandbox.kopokopo.com
KOPOKOPO_AUTH_URL=https://sandbox.kopokopo.com
KOPOKOPO_CLIENT_ID=
KOPOKOPO_CLIENT_SECRET=
KOPOKOPO_API_KEY=
KOPOKOPO_WEBHOOK_URL=https://visionarypos.cloud/api/integrations/kopokopo/webhook
KOPOKOPO_SCOPE=company
KOPOKOPO_SCOPE_REFERENCE=
KOPOKOPO_TILL_BRANCH_MAP={}
KOPOKOPO_ADDITIONAL_ACCOUNTS=
KOPOKOPO_SIPCITY_CLIENT_ID=
KOPOKOPO_SIPCITY_CLIENT_SECRET=
KOPOKOPO_SIPCITY_API_KEY=
KOPOKOPO_SIPCITY_BRANCH_ID=b_sip
KOPOKOPO_SIPCITY_TILL_NUMBER=
KOPOKOPO_SANDBOX_BRANCH_ID=b_sip
KOPOKOPO_POLLING_ENABLED=0
KOPOKOPO_POLL_INTERVAL_MS=120000
KOPOKOPO_POLL_TIMEOUT_MS=300000
